# Discord Developer Portal → Your App → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI you add in the Discord app's OAuth2 settings
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Discord Developer Portal → Your App → Bot → Token
# The bot must be invited into your server (see README).
DISCORD_BOT_TOKEN=

# Right-click your server icon in Discord (Developer Mode on) → Copy Server ID
DISCORD_GUILD_ID=

# Right-click the role in Server Settings → Roles → Copy Role ID
DISCORD_MEMBER_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=

# Any long random string — used to sign session cookies
SESSION_SECRET=

PORT=3000
